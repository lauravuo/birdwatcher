rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users: Can read their own profile, write to add themselves to groups
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Groups: All actions require authentication
    // - Create/Read/List: Authenticated users
    // - Update: Owner can update anything; others can only add themselves to memberIds via transforms
    match /groups/{groupId} {
      allow create, get, list: if request.auth != null;
      allow update: if request.auth != null && (
        // Owner can update any field
        resource.data.ownerId == request.auth.uid ||
        // Other users can only modify memberIds (either direct or via transforms)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']))
      );
    }
    
    // Sightings: Authenticated users can create and read sightings
    match /sightings/{sightingId} {
      // Users can create sightings with their own userId
      allow create: if request.auth != null && 
                     request.resource.data.userId == request.auth.uid;
      // Users can read all sightings (for group viewing)
      allow read: if request.auth != null;
      // Users can update/delete their own sightings
      allow update, delete: if request.auth != null && 
                             resource.data.userId == request.auth.uid;
    }
  }
}
