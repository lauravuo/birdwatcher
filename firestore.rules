rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users: Can read/write their own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Groups: 
    // - Create/Get/List/Update: Authenticated users
    // Note: Update is allowed for all authenticated users to support the client-side join flow.
    match /groups/{groupId} {
      allow create, get, list, update: if request.auth != null;
    }
  }
}
