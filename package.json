{
	"name": "birdwatcher",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/lauravuo/birdwatcher.git"
	},
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest",
		"test:all": "npm run build && npm run format && npm test -- --run && npm run test:e2e",
		"test:e2e": "dotenv -e .env.test -- playwright test",
		"test:e2e:emulator": "firebase emulators:exec --only auth,firestore --project demo-test \"npm run test:e2e\"",
		"clean:emulators": "lsof -ti:8080,9099,4000,4400 | xargs kill -9 2>/dev/null || true && rm -f .firebase/emulators.pid",
		"emulator:start": "firebase emulators:start --only auth,firestore",
		"preview": "vite preview",
		"prepare": "husky"
	},
	"dependencies": {
		"firebase": "^12.8.0",
		"i18next": "^25.8.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-i18next": "^16.5.4",
		"react-router-dom": "^7.13.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.13",
		"@playwright/test": "^1.58.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^25.1.0",
		"@types/react": "^19.2.10",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"dotenv-cli": "^11.0.0",
		"firebase-tools": "^15.4.0",
		"happy-dom": "^20.4.0",
		"husky": "^9.1.7",
		"typescript": "~5.9.3",
		"vite": "^7.3.1",
		"vitest": "4.0.18"
	}
}
