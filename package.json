{
	"name": "birdwatcher",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/lauravuo/birdwatcher.git"
	},
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest",
		"test:all": "npm run build && npm run format && npm test -- --run && npm run test:e2e:emulator",
		"test:e2e": "playwright test",
		"test:e2e:emulator": "dotenv -e .env.test -- firebase emulators:exec --only auth,firestore --project demo-test \"npm run test:e2e\"",
		"clean:emulators": "lsof -ti:8080,9099,4000,4400 | xargs kill -9 2>/dev/null || true && rm -f .firebase/emulators.pid",
		"emulator:start": "firebase emulators:start --only auth,firestore",
		"preview": "vite preview",
		"prepare": "husky"
	},
	"dependencies": {
		"firebase": "^12.7.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"@playwright/test": "^1.57.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.1",
		"@types/node": "^25.0.3",
		"@types/react": "^19.2.5",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"dotenv-cli": "^11.0.0",
		"firebase-tools": "^15.1.0",
		"happy-dom": "^20.0.11",
		"husky": "^9.1.7",
		"typescript": "~5.9.3",
		"vite": "^7.2.4",
		"vitest": "4.0.16"
	}
}
