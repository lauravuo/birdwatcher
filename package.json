{
	"name": "birdwatcher",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/lauravuo/birdwatcher.git"
	},
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest",
		"test:all": "npm run build && npm run format && npm test -- --run && npm run test:e2e:emulator",
		"test:e2e": "dotenv -e .env.test -- playwright test",
		"test:e2e:emulator": "firebase emulators:exec --only auth,firestore --project demo-test \"npm run test:e2e\"",
		"clean:emulators": "lsof -ti:8080,9099,4000,4400 | xargs kill -9 2>/dev/null || true && rm -f .firebase/emulators.pid",
		"emulator:start": "firebase emulators:start --only auth,firestore",
		"preview": "vite preview",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,ts,tsx,css,json}": [
			"biome check --write"
		],
		"*.{ts,tsx,js}": [
			"vitest related --run"
		]
	},
	"dependencies": {
		"firebase": "^12.17.1",
		"i18next": "^26.3.6",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-i18next": "^17.0.11",
		"react-router-dom": "^7.18.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@playwright/test": "^1.62.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"dotenv-cli": "^11.0.0",
		"firebase-tools": "^15.26.0",
		"happy-dom": "^20.11.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"typescript": "~7.0.2",
		"vite": "^8.2.1",
		"vitest": "4.1.10"
	}
}
