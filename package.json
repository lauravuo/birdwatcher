{
	"name": "birdwatcher",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/lauravuo/birdwatcher.git"
	},
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest",
		"test:all": "npm run build && npm run format && npm test -- --run && npm run test:e2e",
		"test:e2e": "dotenv -e .env.test -- playwright test",
		"test:e2e:emulator": "firebase emulators:exec --only auth,firestore --project demo-test \"npm run test:e2e\"",
		"clean:emulators": "lsof -ti:8080,9099,4000,4400 | xargs kill -9 2>/dev/null || true && rm -f .firebase/emulators.pid",
		"emulator:start": "firebase emulators:start --only auth,firestore",
		"preview": "vite preview",
		"prepare": "husky"
	},
	"lint-staged": {
		"*.{js,ts,tsx,css,json}": [
			"biome check --write"
		],
		"*.{ts,tsx,js}": [
			"vitest related --run"
		]
	},
	"dependencies": {
		"firebase": "^12.11.0",
		"i18next": "^25.8.20",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-i18next": "^16.5.8",
		"react-router-dom": "^7.13.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.8",
		"@playwright/test": "^1.58.2",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^25.5.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"dotenv-cli": "^11.0.0",
		"firebase-tools": "^15.11.0",
		"happy-dom": "^20.8.4",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"typescript": "~5.9.3",
		"vite": "^8.0.1",
		"vitest": "4.1.0"
	}
}
