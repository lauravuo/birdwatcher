#!/usr/bin/env sh

# Run full project checks before pushing
npm run build
npm test -- --run

# Check if any code files changed in src/ or e2e/ directories
CHANGED_FILES=$(git diff --name-only @{upstream}..HEAD)
CODE_CHANGED=$(echo "$CHANGED_FILES" | grep -E '^(src|e2e)/.*\.(ts?|tsx?|jsx?|css|html)$' || true)

if [ -n "$CODE_CHANGED" ]; then
  # Code files changed, run E2E tests
  npm run test:e2e:emulator
fi
