#!/usr/bin/env sh

# Check if only .md files changed
CHANGED_FILES=$(git diff --name-only origin/copilot/set-up-copilot-instructions..HEAD)
if echo "$CHANGED_FILES" | grep -qv '\.md$'; then
  # Non-markdown files changed, run full tests
  npm run test:e2e:emulator
fi

npm run format
npm run build
npm test
